[Unit]
Description=heatd boost dose retrain after a boost cycle (heattrain:local, only when a boost_cycle event is newer than the newest bundle)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=@DEPLOY_USER@
Nice=10
ExecStart=/usr/bin/docker run --rm --cpus 1 --memory 1g -e OMP_NUM_THREADS=1 --entrypoint sh -v @HEATD_ROOT@/data:/data:ro -v @HEATD_ROOT@/models:/models heattrain:local /usr/local/bin/boost
