[Unit]
Description=heatd boost dose retrain after a boost cycle (heattrain:local, only when a boost_cycle event is newer than the newest bundle)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=aapphh
Nice=10
ExecStart=/usr/bin/docker run --rm --cpus 1 --memory 1g -e OMP_NUM_THREADS=1 --entrypoint sh -v /home/aapphh/MLSmartMatterHeat/data:/data:ro -v /home/aapphh/MLSmartMatterHeat/models:/models heattrain:local /usr/local/bin/boost
