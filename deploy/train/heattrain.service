[Unit]
Description=heatd nightly training (thermal bundle + room model) in container
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=@DEPLOY_USER@
Nice=10
ExecStart=/usr/bin/docker run --rm --cpus 2 --memory 3g -v @HEATD_ROOT@/data:/data:ro -v @HEATD_ROOT@/models:/models heattrain:local
