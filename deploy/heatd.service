[Unit]
Description=heatd smart heating service
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
User=@DEPLOY_USER@
WorkingDirectory=@HEATD_ROOT@
Environment=HEATD_CONFIG=@HEATD_ROOT@/heatd.toml
ExecStart=@HEATD_ROOT@/target/release/heatd serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
